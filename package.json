{
    "name": "@liry24/igdb",
    "version": "4.0.1",
    "description": "A small, type-safe, zero-dependency IGDB API client for Node.js and Web runtimes.",
    "keywords": [
        "api",
        "apicalypse",
        "games",
        "igdb",
        "twitch",
        "typescript"
    ],
    "homepage": "https://github.com/liry24/igdb#readme",
    "bugs": {
        "url": "https://github.com/liry24/igdb/issues"
    },
    "license": "MIT",
    "author": "Liry24",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liry24/igdb.git"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "THIRD_PARTY_NOTICES.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "check": "npm run schema:check && npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run typecheck:package && npm run pack:check",
        "schema:generate": "node scripts/generate-schema.ts",
        "schema:check": "node scripts/generate-schema.ts --check",
        "schema:update": "node scripts/generate-schema.ts --update",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "typecheck": "tsrs --noEmit",
        "typecheck:package": "tsrs -p tsconfig.consumer.json && tsrs -p tsconfig.consumer.json --module ESNext --moduleResolution Bundler",
        "test": "vitest run",
        "test:watch": "vitest",
        "deps:update": "taze major -w",
        "pack:check": "node scripts/verify-package.ts --prepare && npm pack --ignore-scripts --pack-destination .package-check && node --experimental-vm-modules scripts/verify-package.ts --keep",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@types/node": "^26.6.11",
        "oxfmt": "^0.80.0",
        "oxlint": "^1.95.0",
        "oxlint-tsgolint": "7.0.2009",
        "taze": "^21.3.0",
        "tsdown": "^0.23.7",
        "tsrs": "7.1.0-beta.tsrs5",
        "vite": "^8.4.0",
        "vitest": "^5.1.2"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "upm@1.5.1"
}
